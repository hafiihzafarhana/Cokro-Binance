{
    "swagger": "2.0",
    "info": {
        "description": "API to interact with Binance public endpoints",
        "title": "Binance API Service",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/general/server-time": {
            "get": {
                "description": "Check server time from Binance API",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "General"
                ],
                "summary": "Check server time",
                "responses": {}
            }
        },
        "/market/agregate-trade-lists": {
            "get": {
                "description": "Check agregate trade list from Binance API",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Market"
                ],
                "summary": "Check agregate trade list",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Trading pair symbol (e.g. BTCUSDT)",
                        "name": "symbol",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Number of entries to fetch (min: 100, max: 1000)",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Trade ID to fetch from (default: 0)",
                        "name": "fromId",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Start time in RFC3339 format (e.g. 2025-10-14T00:00:00Z)",
                        "name": "startTime",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "End time in RFC3339 format (e.g. 2025-10-14T12:00:00Z)",
                        "name": "endTime",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Time zone (default: UTC)",
                        "name": "timeZone",
                        "in": "query"
                    }
                ],
                "responses": {}
            }
        },
        "/market/candlestick-data": {
            "get": {
                "description": "Check candle stick data from Binance API",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Market"
                ],
                "summary": "Check candle stick data",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Trading pair symbol (e.g. BTCUSDT)",
                        "name": "symbol",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Number of entries to fetch (min: 100, max: 1000)",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Start time in RFC3339 format (e.g. 2025-10-14T00:00:00Z)",
                        "name": "startTime",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "End time in RFC3339 format (e.g. 2025-10-14T12:00:00Z)",
                        "name": "endTime",
                        "in": "query"
                    },
                    {
                        "enum": [
                            "1m",
                            "3m",
                            "5m",
                            "15m",
                            "30m",
                            "1h",
                            "2h",
                            "4h",
                            "6h",
                            "12h",
                            "1d",
                            "3d",
                            "1w",
                            "1M"
                        ],
                        "type": "string",
                        "description": "Candle stick interval (e.g. 1m, 5m, 1h, 1d)",
                        "name": "interval",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Time zone (default: UTC)",
                        "name": "timeZone",
                        "in": "query"
                    },
                    {
                        "enum": [
                            "klines",
                            "uiklines"
                        ],
                        "type": "string",
                        "description": "Type of kline (default: klines)",
                        "name": "typeKline",
                        "in": "query"
                    }
                ],
                "responses": {}
            }
        },
        "/market/current-average-price": {
            "get": {
                "description": "Check current average price from Binance API",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Market"
                ],
                "summary": "Check current average price",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Trading pair symbol (e.g. BTCUSDT)",
                        "name": "symbol",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {}
            }
        },
        "/market/day-ticker": {
            "get": {
                "description": "Get 1 day price change statistics (similar to Binance /ticker/tradingDay endpoint)",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Market"
                ],
                "summary": "Get 1 day ticker price change statistics",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Trading pair symbol (e.g. BTCUSDT, ETHUSDT, or multiple: BTCUSDT,ETHUSDT)",
                        "name": "symbol",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Type of request (optional, e.g. FULL, MINI)",
                        "name": "type",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Time zone (default: UTC)",
                        "name": "timeZone",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Filter by symbol status (TRADING, HALT, BREAK)",
                        "name": "symbolStatus",
                        "in": "query"
                    }
                ],
                "responses": {}
            }
        },
        "/market/old-trade-lookup": {
            "get": {
                "description": "Check old trade lookup from Binance API",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Market"
                ],
                "summary": "Check old trade lookup",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Trading pair symbol (e.g. BTCUSDT)",
                        "name": "symbol",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Number of entries to fetch (min: 100, max: 1000)",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Trade ID to fetch from (default: 0)",
                        "name": "fromId",
                        "in": "query"
                    }
                ],
                "responses": {}
            }
        },
        "/market/order-book": {
            "get": {
                "description": "Check order book from Binance API",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Market"
                ],
                "summary": "Check order book",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Trading pair symbol (e.g. BTCUSDT)",
                        "name": "symbol",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Number of entries to fetch (default: 100, min: 100, max: 5000)",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {}
            }
        },
        "/market/price-change-24hr": {
            "get": {
                "description": "Get 24-hour price change statistics (similar to Binance /ticker/24hr endpoint)",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Market"
                ],
                "summary": "Get 24-hour ticker price change statistics",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Trading pair symbol (e.g. BTCUSDT, ETHUSDT, or multiple: BTCUSDT,ETHUSDT)",
                        "name": "symbol",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Type of request (optional, e.g. FULL, MINI)",
                        "name": "type",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Filter by symbol status (TRADING, HALT, BREAK)",
                        "name": "symbolStatus",
                        "in": "query"
                    }
                ],
                "responses": {}
            }
        },
        "/market/recent-trade-lists": {
            "get": {
                "description": "Check recent trade list from Binance API",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Market"
                ],
                "summary": "Check recent trade list",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Trading pair symbol (e.g. BTCUSDT)",
                        "name": "symbol",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Number of entries to fetch (min: 100, max: 1000)",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {}
            }
        }
    }
}